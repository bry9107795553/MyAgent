# ================================================================
# MyAgent 模型配置 — 复制为 backend/.env 后按需修改
# ================================================================
# 支持两种模式：
#   1. 本地 GGUF — INFERENCE_MODE=local，设置 LLAMA_MODEL 为绝对路径
#   2. 远程 API — INFERENCE_MODE=api，设置 LLAMA_BASE_URL + LLAMA_API_KEY
# 修改后执行 bash stop.sh && bash start.sh 生效
# ================================================================

# === 推理模式 ===
# local = 纯本机 llama.cpp（AMD 黑客松必选）
# api   = 远程 API（如 OpenAI / DashScope 等）
INFERENCE_MODE=local

# === 本地 GGUF 模式（INFERENCE_MODE=local） ===
LLAMA_MODEL=/root/llama.cpp/models/qwen2.5-14b-instruct-q4_k_m.gguf
LLAMA_PORT=8000
NGL=99
CTX_SIZE=8192
SINGLE_GPU_MODE=true

# === 远程 API 模式（INFERENCE_MODE=api） ===
# LLAMA_BASE_URL=https://api.openai.com/v1
# LLAMA_API_KEY=sk-your-key-here
# LLAMA_MODEL=gpt-4

PROMPT_VARIANT=slim
