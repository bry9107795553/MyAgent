{
  "id": "dev_full",
  "name": "完整开发工作组",
  "description": "单轮自驱动开发：需求分析→方案→设计→编码→审查→测试→部署→清理",
  "trigger_keywords": [
    "开发", "做项目", "写应用", "建网站", "做一个", "实现一个", "开发一个",
    "写一个", "建一个", "创建", "搭建",
    "帮我写", "帮我做", "帮我建", "帮我开发",
    "网页", "网站", "前端页面", "静态页面"
  ],
  "trigger_examples": [
    "开发一个待办事项应用",
    "做一个电商网站",
    "写一个API服务"
  ],
  "members": [
    "coach", "designer", "developer", "inspector", "tester", "deployer", "cleaner", "experience_evaluator"
  ],
  "pipeline": [
    {
      "step": 1,
      "role": "coach",
      "action": "分析用户需求并产出项目计划。⚠ 此模式为自动执行，用户不在线，你必须自主决策：用合理默认值填充所有空白，直接产出PROJECT_PLAN。禁止提问，禁止等待用户确认。",
      "input_from": "user",
      "output_to": "step_2",
      "parallel_with": [],
      "condition": ""
    },
    {
      "step": 2,
      "role": "designer",
      "action": "根据项目计划产出HTML设计稿和CSS tokens。默认风格：现代极简、响应式、暗色/亮色自适应。无需用户确认，直接产出完整设计。",
      "input_from": "step_1",
      "output_to": "step_3",
      "parallel_with": [],
      "condition": ""
    },
    {
      "step": 3,
      "role": "developer",
      "action": "按项目计划和设计稿实现代码。用 file_write 工具将代码写入项目目录。技术栈默认：React+Vite+CSS Modules。",
      "input_from": "step_2",
      "output_to": "step_4",
      "parallel_with": [],
      "condition": ""
    },
    {
      "step": 4,
      "role": "inspector",
      "action": "审查developer产出的代码。⚠ 只审查真实存在的文件，用file_list验证。如果上一步未产出代码，报告'无代码，跳过'。",
      "input_from": "step_3",
      "output_to": "step_5",
      "parallel_with": [],
      "condition": ""
    },
    {
      "step": 5,
      "role": "tester",
      "action": "测试代码。⚠ 只测试真实文件。先用file_list确认文件存在。无文件则报告'无代码，跳过'。",
      "input_from": "step_4",
      "output_to": "step_6",
      "parallel_with": [],
      "condition": ""
    },
    {
      "step": 6,
      "role": "deployer",
      "action": "部署上线。产出部署报告和访问链接。如无代码产出则报告'无可部署内容'。",
      "input_from": "step_5",
      "output_to": "step_7",
      "parallel_with": [],
      "condition": ""
    },
    {
      "step": 7,
      "role": "cleaner",
      "action": "清理临时文件和构建缓存",
      "input_from": "step_6",
      "output_to": "user",
      "parallel_with": [],
      "condition": ""
    }
  ],
  "conditions": {
    "max_revisions": 3,
    "auto_approve": true,
    "exit_criteria": "所有模块通过巡检与测试，部署成功且临时文件已清理"
  }
}
