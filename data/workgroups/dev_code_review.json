{
  "id": "dev_code_review",
  "name": "代码审查工作组",
  "description": "对现有代码进行系统性审查，识别技术债并修复，确保代码质量达标",
  "trigger_keywords": ["审查代码", "巡检", "检查代码质量", "代码审查", "review代码"],
  "trigger_examples": ["审查这个项目的代码质量", "巡检最近的提交", "检查代码规范", "review代码"],
  "members": ["inspector", "developer", "tester", "cleaner"],
  "pipeline": [
    {
      "step": 1,
      "role": "inspector",
      "action": "逐项核查 14 项代码质量标准：代码规范、类型安全、错误处理、安全性、性能、可维护性、可测试性、命名规范、注释完整性、依赖管理、API 设计、资源管理、并发安全、文档一致性",
      "input_from": "user",
      "output_to": "step_2",
      "parallel_with": [],
      "condition": ""
    },
    {
      "step": 2,
      "role": "inspector",
      "action": "识别技术债：标记问题项并分类记录，生成审查报告",
      "input_from": "step_1",
      "output_to": "step_3",
      "parallel_with": [],
      "condition": ""
    },
    {
      "step": 3,
      "role": "developer",
      "action": "修复代码问题并偿还识别出的技术债",
      "input_from": "step_2",
      "output_to": "step_4",
      "parallel_with": [],
      "condition": ""
    },
    {
      "step": 4,
      "role": "tester",
      "action": "验证修复后代码行为正确，运行测试套件确保无回归",
      "input_from": "step_3",
      "output_to": "step_5",
      "parallel_with": [],
      "condition": "inspector 判定不通过则返回 step_3，循环最多3次"
    },
    {
      "step": 5,
      "role": "cleaner",
      "action": "清理审查过程中产生的废弃文件、临时报告",
      "input_from": "step_4",
      "output_to": "user",
      "parallel_with": [],
      "condition": "审查通过后执行"
    }
  ],
  "conditions": {
    "max_revisions": 3,
    "user_confirmation_points": ["审查报告产出后可选确认修复范围"],
    "exit_criteria": "14 项标准全部通过且测试无回归，废弃文件已清理"
  },
  "gpu_plan": {
    "parallel_capable": false,
    "note": "代码审查为串行流程，inspector → developer → tester 依次执行，无需并行 GPU"
  }
}
